LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
# Flood ML dataset: zenodo | local | kaggle
FLOOD_DATASET_PROVIDER=zenodo
# For local/Kaggle providers configure FLOOD_DATASET_PATH, KAGGLE_DATASET, KAGGLE_FILE as needed.
# Flood ML precipitation integration:
# event_text = rainfall explicitly mentioned in IMD flood descriptions (default)
# csv = an event-level precipitation table, such as one prepared from IPED
FLOOD_RAINFALL_SOURCE=event_text
# FLOOD_RAINFALL_PATH=/absolute/path/to/event_rainfall.csv
# Optional Kaggle integration:
# KAGGLE_DATASET=owner/dataset-name
# KAGGLE_FILE=data.csv
